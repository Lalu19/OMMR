@using Microsoft.Extensions.Configuration;
@using Microsoft.AspNetCore.Http
@inject IConfiguration Configuration;

@{
    ViewBag.Title = "Screen List";
    string apiUrl = Configuration.GetValue<string>("WebAPIBaseUrl");
}

<style>
    /* CSS for loader */
    .loader {
        border: 8px solid #f3f3f3;
        border-radius: 50%;
        border-top: 8px solid #3498db;
        width: 50px;
        height: 50px;
        -webkit-animation: spin 1s linear infinite; /* Safari */
        animation: spin 1s linear infinite;
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 9999;
        display: none; /* Initially hide loader */
    }

    @@-webkit-keyframes spin {
        0% {
            -webkit-transform: rotate(0deg);
        }

        100% {
            -webkit-transform: rotate(360deg);
        }
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /*   .radio-container {
                    display: inline-block;
                    margin-right: 10px;
                }

                    .radio-container:last-child {
                        margin-right: 0;
                    }

                    .radio-container input[type="radio"] {
                        margin-right: 5px;
                    } */


    /* Add some spacing around the radio button and label */
    .radio-container {
        display: inline-block; /* Display inline */
        margin-right: 10px; /* Adjust spacing between radio buttons */
    }

        .radio-container:last-child {
            margin-right: 0; /* Remove margin from the last radio button */
        }

        .radio-container input[type="radio"] {
            display: none; /* Hide the actual radio button */
        }
            /* Style for the label when the radio button is checked */
            .radio-container input[type="radio"]:checked + label {
                background-color: #28a745; /* Change background color */
                color: #fff; /* Change text color */

</style>

<div id="loader" class="loader"></div>

<!-- PAGE-HEADER -->
<div class="page-header">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#"><i class="fe fe-file-text mr-1"></i>Admin Console</a></li>
        <li class="breadcrumb-item active" aria-current="page">Screen List View</li>
    </ol>
</div>

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Screen List</div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="stateFilter">STATE:</label>
                            <div class="input-box">
                                <select multiple="multiple" class="form-control select2 w-100" id="selectStates" name="selectedState[]">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="cityFilter">CITY:</label>
                            <div class="input-box">
                                <select multiple="multiple" class="form-control select2 w-100" @*class="form-control cityFilter"*@ id="selectcity" name="selectedcity[]">
                                </select>
                            </div>
                        </div>
                    </div>

                    @* <div class="col-md-4">
                    <div class="form-group">
                    <label for="theaterFilter">Theater:</label>
                    <div class="input-box">
                    <select multiple="multiple" class="multi-select" id="selectTheater" name="selectTheater[]">
                    </select>
                    </div>
                    </div>
                    </div>*@

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="secFilter">SEC:</label>
                            <div class="input-box">
                                <select multiple="multiple" class="form-control select2 w-100" @*class="form-control cityFilter"*@ id="selectSec" name="selectedSec[]">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="ratingFilter">THEATRE RATING:</label>
                            <div class="input-box">
                                <select multiple="multiple" class="form-control select2 w-100" @*class="form-control cityFilter"*@ id="selectRating" name="selectedRating[]">
                                </select>
                            </div>
                        </div>
                    </div>

                    @*<div class="col-md-2">
                    <div class="form-group">
                    <label for="mediaFilter">MEDIA:</label>
                    <div class="input-box">
                    <select multiple="multiple" class="form-control select2 w-100"  id="selectMedia" name="selectedMedia[]">
                    </select>
                    </div>
                    </div>
                    </div>*@

                </div>



                <div class="row">

                    <div class="col-md-3">
                        <div class="form-group">
                            <label style="font-weight:bold;" for="estimatedBudget">ESTIMATED BUDGET:</label>
                            <div class="input-box">
                                <input type="text" class="form-control" id="estimatedBudget" name="estimatedBudget" placeholder="Estimated Budget" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label style="font-weight:bold;" for="mediaFilters">MEDIA HOUSE:</label>
