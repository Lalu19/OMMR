                                <select multiple="multiple" class="form-control select2 w-100" id="selectMediaHouse" name="selectedMediaHouse[]">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label style="font-weight:bold;" for="campaignPeriod">CAMPAIGN PERIOD:</label>
