                                <input type="number" class="form-control" id="campaignPeriod" name="campaignPeriod" placeholder="Enter Campaign Period">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label style="font-weight:bold;" for="adDuration">AD DURATION:</label>
                            <div class="input-box">
                                <input type="number" class="form-control" id="adDuration" name="adDuration" placeholder="Enter Ad Duration">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="form-group">
                            <label for="adDuration"></label>
