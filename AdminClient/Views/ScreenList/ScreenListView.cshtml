        function GetRating() {
            $.ajax({
                type: "GET",
                url: "@apiUrl/api/ScreenList/GetTheaterRatingList",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "authorization": "Bearer @Context.Session.GetString("TokenTxt")"
