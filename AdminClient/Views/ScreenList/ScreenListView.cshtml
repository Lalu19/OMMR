            function updateEstimatedBudget() {
                // Get the filtered data from the DataTable
                var filteredData = table.rows({ search: 'applied' }).data().toArray();

                // Initialize sumOfRate
                var sumOfRate = 0;

                // Get selected options from Media and MediaHouse dropdowns
                var selectedMedia = $('#selectMedia').val();
                var selectedMediaHouse = $('#selectMediaHouse').val();

                // Check if Media House is selected
                if (selectedMediaHouse) {
                    // Loop through each selected Media House
                    selectedMediaHouse.forEach(function (mediaHouse) {
                        // Filter data based on selected Media House
                        var filteredMediaData = filteredData.filter(function (row) {
                            return row.media === mediaHouse;
                        });

                        // Calculate the sum of rates
                        var totalRate = filteredMediaData.reduce(function (acc, curr) {
                            return acc + parseFloat(curr.rate);
                        }, 0);

                        // Add to the total sum
                        sumOfRate += totalRate;
                    });
                }

                // Check if Media is selected
                if (selectedMedia) {
                    // Loop through each selected Media
                    selectedMedia.forEach(function (media) {
                        // Filter data based on selected Media
                        var filteredMediaData = filteredData.filter(function (row) {
                            return row.media === media;
                        });

                        // Calculate the sum of rates
                        var totalRate = filteredMediaData.reduce(function (acc, curr) {
                            return acc + parseFloat(curr.rate);
                        }, 0);

                        // Add to the total sum
                        sumOfRate += totalRate;
                    });
                }

                // Apply the multiplication factor based on Media selection
                if (selectedMediaHouse && (selectedMediaHouse.includes('UFO') || selectedMediaHouse.includes('QUBE'))) {
                    // Multiply sumOfRate by 4 if Media is UFO or QUBE
                    sumOfRate *= 4;
                }
                if (selectedMediaHouse && (selectedMediaHouse.includes('PVR INOX') || selectedMediaHouse.includes('Cinepolis'))) {
                    // Multiply sumOfRate by 5 if Media is PVR INOX or Cinepolis
                    sumOfRate *= 5;
                }

                // Display the sum in the 'ESTIMATED BUDGET' text box
                $('#estimatedBudget').val(sumOfRate);
            }

            function totalCapacityUpdate() {
                // Get the filtered data from the DataTable
                var filteredData = table.rows({ search: 'applied' }).data().toArray();

                // Initialize totalCapacity
                var totalCapacity = 0;

                // Get selected options from Media and MediaHouse dropdowns
                var selectedMedia = $('#selectMedia').val();
                var selectedMediaHouse = $('#selectMediaHouse').val();

                // Check if Media House is selected
                if (selectedMediaHouse) {
                    // Loop through each selected Media House
                    selectedMediaHouse.forEach(function (mediaHouse) {
                        // Filter data based on selected Media House
                        var filteredMediaData = filteredData.filter(function (row) {
                            return row.media === mediaHouse;
                        });

                        // Calculate the total capacity
                        var capacity = filteredMediaData.reduce(function (acc, curr) {
                            return acc + parseInt(curr.noofSeats);
                        }, 0);

                        // Add to the total capacity
                        totalCapacity += capacity;
                    });
                }

                // Check if Media is selected
                if (selectedMedia) {
                    // Loop through each selected Media
                    selectedMedia.forEach(function (media) {
                        // Filter data based on selected Media
                        var filteredMediaData = filteredData.filter(function (row) {
                            return row.media === media;
                        });

                        // Calculate the total capacity
                        var capacity = filteredMediaData.reduce(function (acc, curr) {
                            return acc + parseInt(curr.noofSeats);
                        }, 0);

                        // Add to the total capacity
                        totalCapacity += capacity;
                    });
                }

                // Apply the multiplication factor based on Media selection
                if (selectedMediaHouse && (selectedMediaHouse.includes('UFO') || selectedMediaHouse.includes('QUBE'))) {
                    // Multiply totalCapacity by 4 if Media is UFO or QUBE
                    totalCapacity *= 4;
                }
                if (selectedMediaHouse && (selectedMediaHouse.includes('PVR INOX') || selectedMediaHouse.includes('Cinepolis'))) {
                    // Multiply totalCapacity by 5 if Media is PVR INOX or Cinepolis
                    totalCapacity *= 5;
                }

                // Display the total capacity in the 'ESTIMATED BUDGET' text box
                $('#totalCapacityAll').val(totalCapacity);
                var totalCapacityValue = totalCapacity;
            }

            function initializeDataTable() {
                table = $('#Agent_Tb').DataTable({
                    "dom": 'Bfrtip',
                    "buttons": [
                        {
                            extend: 'excel',
                            text: 'Export to Excel',
                            action: function (e, dt, button, config) {
                                var filteredData = dt.rows({ search: 'applied' }).data().toArray();
                                console.log(filteredData); // Or perform any other action you desire
                                var exportData = dt.buttons.exportData({
                                    modifier: {
                                        search: 'applied'
                                    }
                                });

                                $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config, exportData);
                                saveDataToDatabase(filteredData);
                            }
                        }
                    ],
                    "searching": true,
                    "paging": true,
                    "sort": true,
                    "info": true,
                    "ajax": {
                        "url": '@apiUrl/api/ScreenList/GetallList',
                        "type": "GET",
                        "dataType": "json",
                        "headers": {
                            "authorization": "Bearer @Context.Session.GetString("TokenTxt")"
                        },
                        "error": function (xhr, error, thrown) {
                            console.log("Error:", error);
                            console.log("Thrown:", thrown);
                            if (xhr.status == 401) {
                                window.location.replace('/Message/TokenExpire');
                            } else if (xhr.status == 403) {
                                window.location.replace('/Message/Unauthorize');
                            }
                        }
                    },
                    "order": [],
                    "columns": [
                        { "data": "region", "orderable": true, "visible": true },
                        { "data": "state", "orderable": true, "visible": true },
                        { "data": "city", "orderable": true, "visible": true },
                        { "data": "district", "orderable": true, "visible": true },
                        { "data": "theatreCode", "orderable": true, "visible": true },
                        { "data": "theatreName", "orderable": true, "visible": true },
                        { "data": "sec", "orderable": true, "visible": true },
                        { "data": "screen", "orderable": true, "visible": true },
                        { "data": "noofSeats", "orderable": true, "visible": true },
                        { "data": "theatreRating", "orderable": true, "visible": true },
                        { "data": "rate", "orderable": true, "visible": true },
                        { "data": "media", "orderable": true, "visible": true },
                    ]
                });

                function saveDataToDatabase(data) {

                    data.forEach(function (item) {
                        item.createdBy = @Context.Session.GetInt32("UserId");
                    });
                    $.ajax({
                        type: "POST",
                        url: '@apiUrl/api/ClientSearch/SaveDataToDatabase/SaveDataToDatabase', // Change this to the correct API endpoint for saving data
                        contentType: "application/json",
                        data: JSON.stringify(data),
                        success: function (response) {
                            console.log("Data saved to the database: " + response);

                        },
                        error: function (error) {
                            console.error("Error saving data to the database: " + error);
                        }
                    });
                }


                // Calculate and display the initial sum of 'rate' values
                updateEstimatedBudget();
                totalCapacityUpdate();
            }
        });




    </script>
