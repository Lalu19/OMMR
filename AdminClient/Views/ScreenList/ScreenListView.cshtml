                        options.push('<option value="' + res.data[i].media + '">' + res.data[i].media + '</option>');
                    }
                    $("#selectMedia").html(options.join(''));
                    $('#selectMedia').multipleSelect({
                        width: '100%'
                    });
                },
                error: function (data) {
                    handleAjaxError(data);
                }
            });
        }

        // Load Media House dropdown
        GetMediaHouse();
        function GetMediaHouse() {
            $.ajax({
                type: "GET",
                url: "@apiUrl/api/ScreenList/GetMediaList",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "authorization": "Bearer @Context.Session.GetString("TokenTxt")"
                },
                dataType: "json",
                success: function (res) {
                    var options = [];
                    // Add the "Select All" option
                    options.push('<option value="__select_all__">Select All</option>');
                    // Populate other options
                    for (var i = 0; i < res.data.length; i++) {
                        options.push('<option value="' + res.data[i].media + '">' + res.data[i].media + '</option>');
                    }
                    $("#selectMediaHouse").html(options.join(''));
                    $('#selectMediaHouse').multipleSelect({
                        width: '100%'
                    });

                    // Handle the "Select All Media" option
                    $('#selectMediaHouse').change(function () {
                        var selectedValues = $(this).val();
                        if (selectedValues && selectedValues.includes('__select_all__')) {
                            // Select all medias except "__select_all__"
                            var allMedias = res.data.map(media => media.media);
                            $('#selectMediaHouse').multipleSelect('setSelects', allMedias);
                        } else if (selectedValues && !selectedValues.includes('__select_all__')) {
                            // If "__select_all__" is unchecked, remove it from the selected values
                            var index = selectedValues.indexOf('__select_all__');
                            if (index !== -1) {
                                selectedValues.splice(index, 1);
                                $('#selectMediaHouse').multipleSelect('setSelects', selectedValues);
                            }
                        }
                    });
                },
                error: function (data) {
                    handleAjaxError(data);
                }
            });
        }


