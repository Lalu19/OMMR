        GetVerdictRadio();
        function GetVerdictRadio() {
            $.ajax({
                type: "GET",
                url: "@apiUrl/api/Verdict/GetVerdictList",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "authorization": "Bearer @Context.Session.GetString("TokenTxt")"
                },
                dataType: "json",
                success: function (res) {
                    console.log(res);
                    var radios = [];
                    for (var i = 0; i < res.data.length; i++) {
                        radios.push('<div class="radio-container">');
                        radios.push('<input type="radio" class="btn-check" name="options-outlined" id="verdict' + i + '" autocomplete="off" value="' + res.data[i].verdictValue + '">');
                        radios.push('<label class="btn btn-outline-success" for="verdict' + i + '">' + res.data[i].verdictName + '</label>');
                        radios.push('</div>');
                    }
                    $("#verdictRadios").html(radios.join(''));

                    // Bind event listener to the newly created radio buttons
                    $('input[name="options-outlined"]').change(function () {
                        if ($(this).is(':checked')) {
                            var estimatedBudget = parseFloat($('#estimatedBudget').val());
                            var campaignPeriod = parseFloat($('#campaignPeriod').val());
                            var adDuration = parseFloat($('#adDuration').val());
                            var newAdDuration = adDuration / 10;


                            var verdictValue = parseFloat($(this).val()) / 100;

                            var projectedCPVValue = (((estimatedBudget * campaignPeriod * newAdDuration) * verdictValue) / 7) / 100;

                            //projectedCPVValue = projectedCPVValue.toFixed(2);
                            //var projectedCPVValue = Math.round(projectedCPVValue)

                            var totalCapacityAll = parseFloat($('#totalCapacityAll').val());

                            var projectedCPVFinalValue = projectedCPVValue / totalCapacityAll;
                            projectedCPVFinalValue = projectedCPVFinalValue.toFixed(2);

                            $('#projectedCPV').val(projectedCPVFinalValue);
                        }
                    });
                },
                error: function (data) {
                    if (data.status == 401) {
                        window.location.replace('/Message/TokenExpire');
                    } else if (data.status == 403) {
                        window.location.replace('/Message/Unauthorize');
                    }
                }
            });
        }


