                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label style="font-weight:bold;" for="projectedCPV">PROJECTED CPV:</label>
                            <div class="input-box">
                                <input type="text" class="form-control" id="projectedCPV" name="projectedCPV" placeholder="Projected CPV" readonly>
                            </div>
                        </div>
                    </div>



                    <div class="col-md-3">
                        <div class="form-group">
                            <div class="input-box">
